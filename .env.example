# ── Required ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Database (default: SQLite in project root) ────────────────────────────────
# DATABASE_URL=sqlite:///msgstack.db
# DATABASE_URL=postgresql://msgstack:msgstack@localhost:5432/msgstack

# ── Pinecone (optional — skip to disable vector search) ──────────────────────
# PINECONE_API_KEY=pcsk_...
# PINECONE_INDEX=msgstack-chunks

# ── API key auth (default: disabled — all requests treated as superuser) ──────
# MSGSTACK_AUTH_ENABLED=false

# ── HTTP Basic Auth for the external-facing URL (default: enabled) ────────────
# MSGSTACK_BASIC_AUTH_ENABLED=true
# MSGSTACK_BASIC_USER=admin
# MSGSTACK_BASIC_PASS=changeme

# ── CORS (default: wildcard — restrict in production) ────────────────────────
# CORS_ORIGINS=https://app.yourcompany.com,https://admin.yourcompany.com

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT=text         # text | json  (use json in prod / Docker)

# ── Rate limits (requests per 60s per IP) ─────────────────────────────────────
# RATE_LIMIT_EXTRACT=10
# RATE_LIMIT_GENERATE=30
# RATE_LIMIT_DEFAULT=120

# ── Token budget (0 = unlimited) ──────────────────────────────────────────────
# DEFAULT_TOKEN_BUDGET=0

# ── Service URL (used in artifact preview links) ──────────────────────────────
# MSGSTACK_BASE_URL=http://localhost:8001

# ── Google Drive integration (OAuth2) ─────────────────────────────────────────
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...